{
  "manifest_version": 3,
  "name": "My Moneycontrol Dashboard",
  "version": "2.5.0",
  "description": "One dashboard for all your Moneycontrol stocks, with price alerts and stock tips picked up from your WhatsApp groups.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://*.moneycontrol.com/*",
    "https://web.whatsapp.com/*",
    "https://api.callmebot.com/*",
    "https://api.telegram.org/*",
    "https://api.anthropic.com/*",
    "https://api.emailjs.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open my dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "wa-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}